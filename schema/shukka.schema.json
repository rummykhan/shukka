{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rummykhan/shukka/v1/schema/shukka.schema.json",
  "title": "shukka.json",
  "description": "The single shukka config in a project root, read by the workflows and the CLI. Role and stack names are derived from project and qualifier and are never written here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "qualifier", "aws", "infra", "apps"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "description": "Project name; prefixes every resource and role. Must not be a prefix of another project's name in the same account.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,20}$"
    },
    "qualifier": {
      "description": "CDK bootstrap qualifier: the project name format, and at most 10 lowercase alphanumerics (CDK limit).",
      "type": "string",
      "allOf": [
        { "pattern": "^[a-z][a-z0-9-]{1,20}$" },
        { "pattern": "^[a-z0-9]{1,10}$" }
      ]
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "region"],
      "properties": {
        "account": { "type": "string", "pattern": "^[0-9]{12}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$" }
      }
    },
    "node": {
      "description": "Node.js major version for checks and builds. Default 22.",
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "paths"],
      "properties": {
        "dir": { "$ref": "#/definitions/path" },
        "paths": { "$ref": "#/definitions/paths" }
      }
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/definitions/app" }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": { "$ref": "#/definitions/command" }
      }
    },
    "alwaysDeploy": {
      "description": "Deploy every app and the infrastructure on each merge, whatever changed. Default false.",
      "type": "boolean"
    }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
    "path": {
      "description": "A path relative to the project root (or build dir): no leading / or -, no .. segment, no spaces, quotes, shell or control characters. Never a command.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!-)(?!(?:.*/)?\\.\\.(?:/|$))[A-Za-z0-9._@+-][A-Za-z0-9._@+/-]*$"
    },
    "glob": {
      "description": "A path or glob relative to the project root: the path rules, plus * ? [ ] { } and , for patterns.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!-)(?!(?:.*/)?\\.\\.(?:/|$))[A-Za-z0-9._@+*?\\[\\]{},-][A-Za-z0-9._@+/*?\\[\\]{},-]*$"
    },
    "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/glob" } },
    "envName": {
      "description": "An environment variable name, refusing names that change the runner, Node, the dynamic loader or AWS credentials.",
      "type": "string",
      "pattern": "^(?!(?:PATH|NODE_OPTIONS|LD_[A-Za-z0-9_]*|GITHUB_[A-Za-z0-9_]*|RUNNER_[A-Za-z0-9_]*|AWS_[A-Za-z0-9_]*|__proto__)$)[A-Za-z_][A-Za-z0-9_]*$"
    },
    "command": { "type": "string", "pattern": "\\S" },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/command" } },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dir", "run"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "dir": { "$ref": "#/definitions/path" },
        "run": { "$ref": "#/definitions/commands" },
        "services": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths", "build", "server"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "paths": { "$ref": "#/definitions/paths" },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dir", "run", "bundle"],
          "properties": {
            "dir": { "$ref": "#/definitions/path" },
            "run": { "$ref": "#/definitions/commands" },
            "bundle": { "$ref": "#/definitions/path" },
            "env": {
              "description": "Non-secret build-time values written in the file.",
              "type": "object",
              "propertyNames": { "$ref": "#/definitions/envName" },
              "additionalProperties": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]*$" }
            },
            "buildEnv": {
              "description": "Names of non-secret build-time values read from GitHub repository variables of the same name.",
              "type": "array",
              "items": { "$ref": "#/definitions/envName" }
            }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configure", "units", "health"],
          "properties": {
            "configure": { "$ref": "#/definitions/path" },
            "units": {
              "type": "array",
              "minItems": 1,
              "items": {
                "description": "A systemd unit name: starts with a letter or digit (never an option), then systemd's unit-name characters except backslash; at most 255.",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{0,254}$"
              }
            },
            "health": {
              "description": "An http(s) URL on the server itself (127.0.0.1 or localhost) the release script polls; URL-safe characters only, no userinfo.",
              "type": "string",
              "pattern": "^https?://(?:127\\.0\\.0\\.1|localhost)(?::(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~%/-]*)?(?:\\?[A-Za-z0-9._~%=-]*)?$"
            }
          }
        }
      }
    }
  }
}
