{
  "name": "shukka",
  "version": "0.0.0",
  "description": "Reusable deployment pipeline for AWS CDK projects on GitHub Actions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rummykhan/shukka.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "actionlint": "actionlint",
    "shellcheck": "find box scripts -name '*.sh' -type f -exec shellcheck {} +",
    "gate": "npm run lint && npm run typecheck && npm test && npm run actionlint && npm run shellcheck"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
