#!/usr/bin/env bash
# Fake aws CLI for the release-script tests: `aws s3 cp s3://<bucket>/<key> <dest> [options]`
# copies /fake-s3/<bucket>/<key> to <dest>. Anything else fails. Every call is logged.
set -uo pipefail
echo "aws $*" >>/var/log/fake-aws.log
[ "${1:-}" = s3 ] && [ "${2:-}" = cp ] || { echo "fake aws: unsupported: $*" >&2; exit 1; }
src=$3 dest=$4
case $src in
  s3://*) path=/fake-s3/${src#s3://} ;;
  *) echo "fake aws: source must be s3://" >&2; exit 1 ;;
esac
[ -f "$path" ] || { echo "fatal error: An error occurred (404) when calling the HeadObject operation: Key \"${src#s3://*/}\" does not exist" >&2; exit 1; }
cp "$path" "$dest"
